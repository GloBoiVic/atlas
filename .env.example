# Atlas environment variables
# Copy to .env and fill in values

# Environment: paper | testnet | production
ATLAS_ENVIRONMENT=paper

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
DATABASE_URL_SYNC=postgresql://atlas:atlas@localhost:5432/atlas

# Binance (paper mode ignores these)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Strategy repository
STRATEGY_REPOSITORY_PATH=/opt/atlas/strategies

# API
API_HOST=0.0.0.0
API_PORT=8000
