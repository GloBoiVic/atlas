ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5432/atlas
# Automated tests use a separate disposable database.
ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5432/atlas_test
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Optional OANDA Practice token. Never commit a real token here.
ATLAS_OANDA_API_TOKEN=replace-with-oanda-practice-token
ATLAS_OANDA_CONNECT_TIMEOUT_SECONDS=5
ATLAS_OANDA_READ_TIMEOUT_SECONDS=20
